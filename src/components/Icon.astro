---
import arrowDown from 'lucide-static/icons/arrow-down.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import discord from 'simple-icons/icons/discord.svg?raw';
import gamepad2 from 'lucide-static/icons/gamepad-2.svg?raw';
import github from 'simple-icons/icons/github.svg?raw';
import globe from 'lucide-static/icons/globe.svg?raw';
import layoutTemplate from 'lucide-static/icons/layout-template.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import monitor from 'lucide-static/icons/monitor.svg?raw';
import palette from 'lucide-static/icons/palette.svg?raw';
import server from 'lucide-static/icons/server.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import ticket from 'lucide-static/icons/ticket.svg?raw';
import workflow from 'lucide-static/icons/workflow.svg?raw';

/**
 * Inline SVG icon. Lucide (ISC) by default, `brand:<slug>` for Simple Icons (CC0). Always decorative.
 *
 * The SVGs are imported at build time with `?raw`, so the markup is fixed before `set:html` renders it.
 * Props only pick an entry from `icons` and set a numeric size; nothing user-controlled reaches the SVG.
 *
 * New icon? Add the import and one entry in `icons`. This map is the bundle ceiling.
 */
interface Props {
  name: string;
  size?: number;
}

const { name, size = 20 } = Astro.props;

const icons: Record<string, string> = {
  'arrow-down': arrowDown,
  'arrow-up-right': arrowUpRight,
  'brand:discord': discord,
  'brand:github': github,
  'gamepad-2': gamepad2,
  'globe': globe,
  'layout-template': layoutTemplate,
  'mail': mail,
  'monitor': monitor,
  'palette': palette,
  'server': server,
  'sparkles': sparkles,
  'ticket': ticket,
  'workflow': workflow,
};

const source = icons[name];
if (!source) throw new Error(`Icon "${name}" is not bundled. Add it to src/components/Icon.astro.`);

const brand = name.startsWith('brand:');
let svg = source.replace(/<!--[\s\S]*?-->/g, '').trim();
svg = brand
  ? svg.replace(/<title>[\s\S]*?<\/title>/, '').replace('<svg', `<svg width="${size}" height="${size}" fill="currentColor"`)
  : svg.replace(/\sclass="[^"]*"/, '').replace(/\swidth="24"/, ` width="${size}"`).replace(/\sheight="24"/, ` height="${size}"`);
svg = svg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
---

<Fragment set:html={svg} />
